{
  "name": "tmx-notes",
  "version": "1.0.0",
  "description": "A production-ready notes app built with Electron, React, and Firebase",
  "main": "./out/main/index.js",
  "author": {
    "name": "TMX",
    "email": "manishnaruka123@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manishnaruka/TMX-NotesOS.git"
  },
  "scripts": {
    "clean": "node ./scripts/clean-build.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:universal": "npm run build && electron-builder --mac --universal",
    "build:linux": "npm run clean && npm run typecheck && npm run build && electron-builder --linux --x64",
    "build:linux:rpm": "npm run clean && npm run typecheck && npm run build && electron-builder --linux rpm --x64",
    "install:linux": "node ./scripts/install-linux-desktop.mjs",
    "build:linux:install": "npm run build:linux && npm run install:linux",
    "build:all": "npm run build && electron-builder --win --mac --linux",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tiptap/extension-highlight": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/extension-task-item": "^2.11.0",
    "@tiptap/extension-task-list": "^2.11.0",
    "@tiptap/extension-underline": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "firebase": "^11.3.0",
    "lucide-react": "^0.574.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.tmx.notes",
    "productName": "TMX Notes",
    "directories": {
      "buildResources": "resources",
      "output": "build"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Office",
      "synopsis": "A secure desktop notes app with Firebase sync",
      "maintainer": "TMX <manishnaruka123@gmail.com>",
      "vendor": "TMX",
      "desktop": {
        "entry": {
          "StartupWMClass": "tmx-notes"
        }
      }
    }
  }
}
